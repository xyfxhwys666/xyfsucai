# Docker Compose 演示配置。均为本地示例值，不包含真实凭据。
MYSQL_DATABASE=material_app
MYSQL_USER=material
MYSQL_PASSWORD=material
MYSQL_ROOT_PASSWORD=root

# 每个后台阶段的模拟耗时，单位毫秒。
TASK_DELAY_MS=1200

# none / ASSET_CHECK / GENERATING / PACKAGING
FAIL_STAGE=none

# 浏览器访问前端的来源，以及浏览器可访问的 Java API 地址。
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080/api
